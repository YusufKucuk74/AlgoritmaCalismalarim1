    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="deger" type="Real" array="False" size=""/>
            <output expression="&quot;Not Giriniz:&quot;" newline="True"/>
            <input variable="deger"/>
            <if expression="deger&gt;84 &amp;&amp; deger&lt;101">
                <then>
                    <output expression="&quot;&#199;ok &#304;yi&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="deger&lt;85 &amp;&amp; deger&gt;64">
                        <then>
                            <output expression="&quot;&#304;yi&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="deger&lt;65 &amp;&amp; deger&gt;49">
                                <then>
                                    <output expression="&quot;Orta&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Ba&#351;ar&#305;s&#305;z&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
