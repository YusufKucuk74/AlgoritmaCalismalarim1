    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sayi1, sayi2, sayi3, ortalama" type="Real" array="False" size=""/>
            <output expression="&quot;Say&#305;1: &quot;" newline="True"/>
            <input variable="sayi1"/>
            <output expression="&quot;Say&#305;2: &quot;" newline="True"/>
            <input variable="sayi2"/>
            <output expression="&quot;Say&#305;3: &quot;" newline="True"/>
            <input variable="sayi3"/>
            <assign variable="ortalama" expression="(sayi1+sayi2+sayi3)/3"/>
            <output expression="ortalama" newline="True"/>
        </body>
    </function>
