<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="grad radyan derece"/>
        <attribute name="authors" value="kucuk"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-11 10:02:24 &#214;S"/>
        <attribute name="created" value="a3VjdWs7REVTS1RPUC1ISFM4NzFEOzIwMjYtMTAtMTE7MDk6NTg6MDUgw5ZTOzMwMDk="/>
        <attribute name="edited" value="a3VjdWs7REVTS1RPUC1ISFM4NzFEOzIwMjYtMTAtMTE7MTA6MDI6MjQgw5ZTOzE7MzA5OQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="derece, radyan, grad" type="Real" array="False" size=""/>
            <output expression="&quot;Derece De&#287;erini Giriniz:&quot;" newline="True"/>
            <input variable="derece"/>
            <assign variable="radyan" expression="derece * (pi / 180)"/>
            <assign variable="grad" expression="derece * (200 / 180)"/>
            <output expression="&quot;Radyan:&quot; &amp; radyan" newline="True"/>
            <output expression="&quot;Grad: &quot; &amp; grad" newline="True"/>
        </body>
    </function>
</flowgorithm>
