<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="girilen say&#305;n&#305;n 3e ve 5e tam b&#246;l&#252;n&#252;p b&#246;l&#252;nmedi&#287;ini s&#246;yleyen algoritma"/>
        <attribute name="authors" value="kucuk"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-08 10:15:08 &#214;S"/>
