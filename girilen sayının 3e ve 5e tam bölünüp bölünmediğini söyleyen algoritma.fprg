    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="deger" type="Integer" array="False" size=""/>
            <output expression="&quot;De&#287;er Giriniz:&quot;" newline="True"/>
            <input variable="deger"/>
            <if expression="deger%3==0 &amp;&amp; deger%5==0">
                <then>
                    <output expression="&quot;3'e ve 5'e tam b&#246;l&#252;n&#252;yor.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;3'e ve 5'e tam b&#246;l&#252;nm&#252;yor.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
