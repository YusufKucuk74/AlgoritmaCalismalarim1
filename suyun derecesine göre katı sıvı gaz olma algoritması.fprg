    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="derece" type="Integer" array="False" size=""/>
            <output expression="&quot;L&#252;tfen derece giriniz: &quot;" newline="True"/>
            <input variable="derece"/>
            <if expression="derece&lt;=0">
                <then>
                    <output expression="&quot;Kat&#305;&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="derece&gt;=100">
                        <then>
                            <output expression="&quot;Gaz&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;S&#305;v&#305;&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
