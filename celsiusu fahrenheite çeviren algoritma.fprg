    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="fahrenheit, celsius" type="Real" array="False" size=""/>
            <output expression="&quot;L&#252;tfen derece giriniz(C): &quot;" newline="True"/>
            <input variable="celsius"/>
            <assign variable="fahrenheit" expression="celsius*1.8+32"/>
            <output expression="&quot;Fahrenheit:&quot;" newline="True"/>
            <output expression="fahrenheit" newline="True"/>
        </body>
    </function>
